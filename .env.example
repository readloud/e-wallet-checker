# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
APP_NAME="E-Wallet OAuth Integration"
APP_URL=https://api.ewallet.com

# ============================================
# SESSION & SECURITY
# ============================================
SESSION_SECRET=your_session_secret_min_32_chars_here
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=7d

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ewallet_oauth
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_MAX=20
DB_POOL_MIN=2

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_SESSION=0
REDIS_DB_CACHE=1

# ============================================
# DANA INTEGRATION
# ============================================
DANA_ENVIRONMENT=sandbox  # sandbox atau production
DANA_CLIENT_ID=your_dana_client_id
DANA_CLIENT_SECRET=your_dana_client_secret
DANA_PRIVATE_KEY_PATH=./keys/dana_private_key.pem
DANA_PUBLIC_KEY_PATH=./keys/dana_public_key.pem
DANA_REDIRECT_URL=https://api.ewallet.com/api/v1/dana/callback
DANA_API_BASE=https://api-sandbox.saas.dana.id
DANA_OAUTH_BASE=https://sandbox.m.dana.id

# ============================================
# SHOPEEPAY INTEGRATION
# ============================================
SHOPEEPAY_ENVIRONMENT=sandbox  # sandbox atau production
SHOPEEPAY_MERCHANT_ID=your_shopeepay_merchant_id
SHOPEEPAY_SECRET_KEY=your_shopeepay_secret_key
SHOPEEPAY_REDIRECT_URL=https://api.ewallet.com/api/v1/shopeepay/callback
SHOPEEPAY_API_BASE=https://api.uat.wallet.airpay.co.id
SHOPEEPAY_OAUTH_BASE=https://pay-shopeepay-uat.airpay.co.id

# ============================================
# QRIS PROVIDER (Pilih salah satu)
# ============================================

# Option 1: InterActive QRIS
QRIS_PROVIDER=interactive
INTERACTIVE_API_KEY=your_api_key
INTERACTIVE_MID=your_merchant_id
INTERACTIVE_API_URL=https://qris.interactive.co.id/restapi/qris

# Option 2: DOKU QRIS
QRIS_PROVIDER=doku
DOKU_CLIENT_ID=your_client_id
DOKU_CLIENT_SECRET=your_client_secret
DOKU_PARTNER_ID=your_partner_id
DOKU_API_URL=https://api.doku.com

# Option 3: Midtrans QRIS
QRIS_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=your_server_key
MIDTRANS_CLIENT_KEY=your_client_key
MIDTRANS_API_URL=https://api.midtrans.com/v2

# ============================================
# WEBHOOK & CALLBACK
# ============================================
QRIS_CALLBACK_URL=https://payment.ewallet.com/api/qris/callback
QRIS_WEBHOOK_SECRET=your_webhook_secret_32_chars

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# ENCRYPTION (untuk token di database)
# ============================================
TOKEN_ENCRYPTION_KEY=32_char_encryption_key_for_tokens