# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production
PORT=3000
APP_NAME="E-Wallet OAuth API"
APP_URL=https://api.ewallet.com
SESSION_SECRET=your_super_secret_session_key_min_32_chars

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ewallet_oauth_prod
DB_USER=ewallet_oauth_user
DB_PASSWORD=StrongP@ssw0rd_Production_2024!

# Database Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE=10000

# ============================================
# REDIS (Session & Cache)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Redis_Prod_Password_2024
REDIS_DB_SESSION=0
REDIS_DB_CACHE=1
REDIS_DB_QUEUE=2

# ============================================
# JWT & API KEYS
# ============================================
JWT_SECRET=jwt_secret_min_32_chars_production_2024
JWT_EXPIRES_IN=7d
API_KEY_HEADER=X-API-Key
SYSTEM_API_KEY=sys_32_char_production_api_key

# ============================================
# DANA OAuth Configuration
# ============================================
# Dapatkan dari DANA setelah onboarding resmi
DANA_ENVIRONMENT=production  # production atau sandbox
DANA_CLIENT_ID=2018080841488945368353
DANA_CLIENT_SECRET=your_dana_client_secret
DANA_PRIVATE_KEY_PATH=/etc/keys/dana_private_key.pem
DANA_PUBLIC_KEY_PATH=/etc/keys/dana_public_key.pem
DANA_REDIRECT_URL=https://api.ewallet.com/oauth/dana/callback
DANA_API_BASE=https://api.saas.dana.id
DANA_OAUTH_BASE=https://m.dana.id

# ============================================
# ShopeePay OAuth Configuration
# ============================================
# Dapatkan dari ShopeePay setelah commercial agreement
SHOPEEPAY_ENVIRONMENT=production
SHOPEEPAY_MERCHANT_ID=SPM123456789
SHOPEEPAY_SECRET_KEY=shopeepay_secret_key_32_chars
SHOPEEPAY_REDIRECT_URL=https://api.ewallet.com/oauth/shopeepay/callback
SHOPEEPAY_API_BASE=https://api.shopeepay.id
SHOPEEPAY_OAUTH_BASE=https://pay.shopeepay.id

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_OAUTH_WINDOW_MS=3600000  # 1 hour
RATE_LIMIT_OAUTH_MAX_REQUESTS=10

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_DIR=/var/log/ewallet-oauth
LOG_RETENTION_DAYS=30

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/123456

# ============================================
# SECURITY
# ============================================
ENCRYPTION_KEY=encryption_key_32_chars_minimum_prod
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
CORS_ORIGIN=https://app.ewallet.com,https://admin.ewallet.com

# ============================================
# ENCRYPTION (Untuk menyimpan token di DB)
# ============================================
TOKEN_ENCRYPTION_KEY=t0k3n_3ncrypt10n_k3y_32_chars
TOKEN_ENCRYPTION_IV=16_char_initial_iv